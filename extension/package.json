{
  "name": "second-look-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension (Manifest V3) that shows privacy findings for a draft post.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "tsx --test \"test/*.test.ts\"",
    "check:ocr": "tsx scripts/check-ocr.ts"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "tesseract.js": "7.0.0"
  }
}
