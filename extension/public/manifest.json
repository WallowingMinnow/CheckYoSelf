{
  "manifest_version": 3,
  "name": "CheckYo'Self (MadHacks prototype)",
  "version": "0.2.0",
  "description": "Check what a post could reveal before you share it.",
  "action": {
    "default_title": "CheckYo'Self",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
