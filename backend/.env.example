# Copy this file to .env (same folder) and fill it in. Never overwrite an existing .env.
# .env is in .gitignore — NEVER commit it, and never put these values in the extension.

# "mock"       = fake keyword-based results, no Databricks needed (default)
# "databricks" = real LLM analysis through Databricks
ANALYSIS_MODE=mock

# Port the backend listens on (the extension expects 8787).
PORT=8787

# --- Databricks: where to send analysis -----------------------------------------
# Our Databricks App (it relays to the hosted model). Not secret.
DATABRICKS_HOST=https://instagram-risk-analyzer-7474656363418981.aws.databricksapps.com
# Model name the app accepts: gpt-oss-120b (recommended) or llama-4-maverick.
DATABRICKS_SERVING_ENDPOINT=gpt-oss-120b
# Path for chat requests; {endpoint} is replaced by the name above.
# Default (from the app handoff): /serving-endpoints/{endpoint}/invocations
# Databricks Apps only accept token calls on /api/ routes, so once the app adds
# its /api/ route (docs/DATABRICKS_APP_API.md), switch to:
#   DATABRICKS_INVOCATIONS_PATH=/api/v1/serving-endpoints/{endpoint}/invocations
DATABRICKS_INVOCATIONS_PATH=

# --- Databricks: authentication --------------------------------------------------
# "oauth-m2m" (recommended): a service principal with CAN USE on the app.
#   The backend gets short-lived OAuth tokens and renews them automatically.
# "pat": a personal access token. Databricks documents OAuth (not PATs) for
#   calling apps, so a PAT may be refused; `npm run check:databricks` will say.
DATABRICKS_AUTH_TYPE=oauth-m2m

# oauth-m2m: tokens come from the WORKSPACE, not the app.
DATABRICKS_WORKSPACE_HOST=https://dbc-d050c3b5-83dc.cloud.databricks.com
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# pat: only when DATABRICKS_AUTH_TYPE=pat
DATABRICKS_TOKEN=

# --- History (approved earlier posts) --------------------------------------------
# "dev-memory"     = TEMPORARY in-memory storage for development. Not Databricks;
#                    cleared when the backend restarts. (default)
# "databricks-app" = stored by the Databricks App. Needs the app's history
#                    endpoints (docs/DATABRICKS_APP_API.md) and the auth above.
HISTORY_STORE=dev-memory

# --- Optional -----------------------------------------------------------------
# If set, the backend only accepts calls from this extension ID
# (find it on chrome://extensions). Leave empty during early development.
ALLOWED_EXTENSION_ID=
